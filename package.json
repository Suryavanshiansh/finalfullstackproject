{
  "name": "fpis-monorepo",
  "version": "1.0.0",
  "description": "Faculty Performance Intelligence System (FPIS) - Complete Production Full-Stack Application",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test",
    "test": "npm run test:server && npm run test:client",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:push": "npm --prefix server run prisma:push",
    "prisma:seed": "npm --prefix server run prisma:seed",
    "start": "npm --prefix server run start"
  },
  "keywords": [
    "faculty-performance",
    "academic-intelligence",
    "workload-management",
    "explainable-scoring",
    "smart-scheduling",
    "react",
    "express",
    "prisma"
  ],
  "author": "Antigravity Engineering Team",
  "license": "UNLICENSED"
}
