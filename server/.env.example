# FPIS Server Configuration

PORT=5000
NODE_ENV=development

# Database Configuration
# Default local SQLite:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fpis?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-very-long-and-secure-random-secret"
JWT_EXPIRES_IN="7d"

# Redis & Event Processing (Optional - auto-falls back to resilient in-process queue if Redis is unavailable)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760 # 10MB
